{
  "name": "dsh-pocket-kit",
  "version": "1.0.2",
  "private": false,
  "type": "module",
  "description": "Independent DeepSeek Harness features with their own switches: in-app directory picking, recovery of prompts swallowed by failed turns, and a bundled whale-girl corner logo.",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuosus/dsh-pocket-kit.git"
  },
  "homepage": "https://github.com/zuosus/dsh-pocket-kit#readme",
  "bugs": {
    "url": "https://github.com/zuosus/dsh-pocket-kit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "input-recovery",
    "directory-picker",
    "sidebar-logo"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node test/host.mjs && node test/config.mjs && node test/client.mjs && node test/render.mjs && node test/banner.mjs && node test/pin-switch.mjs && node test/logo.mjs && node test/logo-client.mjs && node test/resolve.mjs && node test/force-native-host.mjs && node test/plugin-dir.mjs && node test/store-path.mjs && node test/switches.mjs && node test/switches-client.mjs"
  }
}
